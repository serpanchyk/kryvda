SERVICE_NAME=telegram-monitor-scraper
POSTGRES_DSN=postgresql://telegram_monitor:change-me@localhost:5432/telegram_monitor
# Telegram is reached only through the Telegram gateway (apps/telegram-gateway):
# the Vercel deployment URL on the department server, or http://telegram-gateway:8080 locally.
TELEGRAM_GATEWAY_URL=http://localhost:8080
# Must equal TELEGRAM_GATEWAY_TOKEN configured on the gateway.
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_TIMEOUT_SECONDS=330
COLLECTION_POLL_INTERVAL_SECONDS=3600
# Posts per gateway request and gateway requests per channel in one run.
COLLECTION_PAGE_SIZE=200
COLLECTION_MAX_PAGES_PER_CHANNEL=10
# Stored posts this many hours old are re-read each run (edits, forward metadata); 0 disables.
COLLECTION_REFRESH_HOURS=48
CHANNEL_IMAGE_STORAGE_PATH=/var/lib/telegram-monitor/channel-images
