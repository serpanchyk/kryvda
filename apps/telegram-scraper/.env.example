SERVICE_NAME=telegram-monitor-scraper
POSTGRES_DSN=postgresql://telegram_monitor:change-me@localhost:5432/telegram_monitor
# Use a dedicated project Telegram account in production. Keep these values out of git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
# Generate it once with `uv run telegram-monitor-authorize`; deployment injects it from GitHub
# Secrets.
TELEGRAM_SESSION_STRING=
COLLECTION_POLL_INTERVAL_SECONDS=300
