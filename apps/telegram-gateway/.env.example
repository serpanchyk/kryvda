# Telegram gateway settings. On Vercel, add these as Production-only environment variables.
# Locally, Docker Compose reads the same names from the root .env.
SERVICE_NAME=telegram-monitor-gateway
# From https://my.telegram.org for the dedicated collection account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once with `uv run telegram-monitor-authorize`; never reuse it in two places at once.
TELEGRAM_SESSION_STRING=
# Shared secret the scraper sends as a Bearer token; at least 32 characters
# (for example `openssl rand -hex 32`).
TELEGRAM_GATEWAY_TOKEN=
# Longer Telegram flood waits are returned to the scraper as HTTP 429.
TELEGRAM_FLOOD_SLEEP_THRESHOLD_SECONDS=20
