SERVICE_NAME=telegram-monitor-ai-worker
POSTGRES_DSN=postgresql://telegram_monitor:change-me@localhost:5432/telegram_monitor
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000
ANALYSIS_MODEL=MamayLM-Gemma-3-27B-IT
ANALYSIS_POLL_INTERVAL_SECONDS=5
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_REQUEST_TIMEOUT_SECONDS=120
ANALYSIS_ENTITIES_MAX_OUTPUT_TOKENS=1024
ANALYSIS_CLAIMS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_CLASSIFICATION_MAX_OUTPUT_TOKENS=1024
# Number of rapid attempts (immediate, then 5 and 10 seconds) before scheduled retries.
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CLASSIFICATION_BATCH_SIZE=5
ANALYSIS_CONCURRENCY=1
LLM_MAX_CONCURRENCY=1
ANALYSIS_CLASSIFICATION_CONCURRENCY=1
