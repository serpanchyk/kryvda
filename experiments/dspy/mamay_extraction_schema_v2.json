{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telegram-monitor.local/schemas/experiments/mamay_extraction_schema_v2.json",
  "title": "Mamay experimental extraction v2",
  "description": "Reduced, text-grounded semantic extraction contract for the offline Mamay benchmark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotations"],
  "properties": {
    "schema_version": {"const": "mamay_extraction_schema_v2"},
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "stances", "claims"],
      "properties": {
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "stances": {"type": "array", "items": {"$ref": "#/$defs/stance"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    }
  },
  "$defs": {
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_surface_form"],
      "properties": {
        "source_kind": {
          "enum": ["channel_editorial", "named_entity", "external_unnamed", "unknown"]
        },
        "source_surface_form": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "entity": {
      "type": "object",
      "description": "One distinct monitoring-relevant actor, not one textual mention.",
      "additionalProperties": false,
      "required": ["id", "surface_form", "entity_type", "subject_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "surface_form": {"type": "string", "minLength": 1},
        "entity_type": {
          "enum": ["person", "organization", "state_institution", "media_outlet", "political_actor"]
        },
        "subject_role": {"enum": ["primary", "secondary"]}
      }
    },
    "stance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "perspective", "value", "evidence_text"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "perspective": {"$ref": "#/$defs/perspective"},
        "value": {"enum": ["positive", "neutral", "negative", "mixed", "insufficient_context"]},
        "evidence_text": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "normalized_text", "entity_ids", "evidence_text", "attribution", "presentation",
        "epistemic_status", "rhetorical_features"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
        "normalized_text": {"type": "string", "minLength": 1},
        "entity_ids": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^e[1-9][0-9]*$"}
        },
        "evidence_text": {"type": "string", "minLength": 1},
        "attribution": {"$ref": "#/$defs/perspective"},
        "presentation": {"enum": ["editorial", "direct_quote", "reported", "repost"]},
        "epistemic_status": {
          "enum": ["asserted", "alleged", "denied", "hypothetical", "questioned"]
        },
        "rhetorical_features": {
          "type": "array",
          "items": {
            "enum": [
              "derogatory_labeling", "ridicule", "delegitimization",
              "foreign_control_accusation", "corruption_accusation",
              "criminality_accusation", "grant_discrediting", "hypocrisy_claim",
              "call_for_punishment"
            ]
          }
        }
      }
    }
  }
}
