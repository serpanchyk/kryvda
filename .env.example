# Copy to .env next to docker-compose.yaml and fill in the five REQUIRED values.
# Everything else has a working default. Keep .env out of git. See DEPLOY.md.

# ---------------------------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------------------------
# Database password. Use letters and digits only, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Upstream model API key for MamayLM.
LAPATHONIIA_API_KEY=
# Internal secret between the AI worker and its LiteLLM proxy, for example: openssl rand -hex 32
LITELLM_MASTER_KEY=
# Address of the Telegram gateway deployed on Vercel, for example https://kryvda-gateway.vercel.app
TELEGRAM_GATEWAY_URL=
# The same token that is configured on the Telegram gateway (at least 32 characters).
TELEGRAM_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------------------------
# Public web port of the dashboard.
FRONTEND_PORT=80
# Loopback-only ports for maintenance from the server itself.
API_PORT=8000
POSTGRES_PORT=5432
POSTGRES_DB=telegram_monitor
POSTGRES_USER=telegram_monitor
# How often Telegram is collected, in seconds (3600 = hourly).
COLLECTION_POLL_INTERVAL_SECONDS=3600
# Daily database dumps are written to ./backups and kept this many days.
BACKUP_RETENTION_DAYS=14
LAPATHONIIA_API_BASE=https://api.lapathoniia.top
# Safe AI worker defaults. Raise only after the documented benchmark.
ANALYSIS_CONCURRENCY=1
LLM_MAX_CONCURRENCY=1
ANALYSIS_CLASSIFICATION_CONCURRENCY=1
ANALYSIS_ENTITIES_MAX_OUTPUT_TOKENS=1024
ANALYSIS_CLAIMS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_CLASSIFICATION_MAX_OUTPUT_TOKENS=1024
# Number of rapid attempts (immediate, then 5 and 10 seconds) before scheduled retries.
ANALYSIS_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY (not on the department server)
# ---------------------------------------------------------------------------------------------
# Run the Telegram gateway locally instead of using the Vercel deployment:
# COMPOSE_PROFILES=telegram
# TELEGRAM_GATEWAY_URL=http://telegram-gateway:8080
# COLLECTION_POLL_INTERVAL_SECONDS=300
# FRONTEND_PORT=5173
# Credentials of a development Telegram account; never the production session.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE_NUMBER=
# TELEGRAM_SESSION_STRING=
